DB_HOST=localhost
DB_PORT=5432
DB_USER=hrms_webapp
DB_PASSWORD=change-me
DB_NAME=htxhrms
DB_SCHEMA=hrms
PORT=3000

# LLM skill identification. Leave LLM_API_KEY empty (or set LLM_PROVIDER=none) to turn it off.
#   gemini            -> free key at https://aistudio.google.com/apikey (LLM_MODEL optional)
#   openai-compatible -> OpenAI, Groq, OpenRouter, Mistral, Ollama... (LLM_BASE_URL and LLM_MODEL required)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=15000

# Examples for openai-compatible:
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=openai/gpt-oss-120b
#   Ollama: LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=qwen3:8b   (no key needed)
#   OpenAI: LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-5-mini
